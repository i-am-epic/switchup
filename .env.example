# Supabase Postgres (required)
# Project Settings → Database → Connection string
#
# DATABASE_URL = Transaction pooler (port 6543) — used by the Next.js app / Prisma Client
# DIRECT_URL   = Direct connection (port 5432) — used by Prisma Migrate
#
# Replace USER, PASSWORD, and PROJECT_REF with values from your Supabase project.
# If your password has special characters, URL-encode them.

DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# App auth / settings
APP_PASSWORD="career-os"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
APP_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"
